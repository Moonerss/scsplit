Bootstrap: docker
From: mambaorg/micromamba:1.5.10

%labels
    Author scsplit contributors
    Description Runtime dependencies for all scsplit Nextflow processes
    Pipeline scsplit

%files
    containers/environment.yml /environment.yml
%post
    micromamba install --yes --name base --file /environment.yml
    micromamba clean --all --yes
    rm /environment.yml
    mkdir -p /workspace /tmp/scsplit
    chmod 1777 /tmp/scsplit

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export TMPDIR=/tmp/scsplit
    export PATH="/opt/conda/bin:$PATH"

%runscript
    exec "$@"
