{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nf-co.re/scsplit/schema.json",
  "title": "scsplit pipeline parameters",
  "type": "object",
  "required": ["input", "split_column"],
  "properties": {
    "input": {
      "type": "string",
      "format": "file-path",
      "exists": true,
      "description": "CSV samplesheet with name and input columns"
    },
    "split_column": {
      "type": "string",
      "minLength": 1,
      "description": "Cell metadata column used to split each object"
    },
    "output_format": {
      "type": "string",
      "enum": ["h5ad", "rds", "both"],
      "default": "h5ad"
    },
    "outdir": {
      "type": "string",
      "default": "results"
    },
    "container_image": {
      "type": "string",
      "default": "scsplit:0.1.0",
      "description": "Docker image used by all workflow processes"
    }
  }
}
