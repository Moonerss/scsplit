manifest {
    name            = 'scsplit'
    author          = 'scsplit contributors'
    description     = 'Split single-cell data objects by cell metadata'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '0.1.0'
}

plugins {
    id 'nf-schema@2.5.1'
}

params {
    input           = null
    split_column    = null
    output_format   = 'h5ad'
    outdir           = 'results'
    container_image  = 'scsplit:0.1.0'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
}

includeConfig 'conf/base.config'

profiles {
    conda {
        conda.enabled = true
    }
    docker {
        conda.enabled = false
        docker.enabled = true
    }
    singularity {
        conda.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
    }
    apptainer {
        conda.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}


includeConfig 'conf/modules.config'
